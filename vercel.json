{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/resume.pdf",
      "headers": [{ "key": "Content-Disposition", "value": "inline; filename=\"JB-Salvino-Resume.pdf\"" }]
    }
  ]
}
